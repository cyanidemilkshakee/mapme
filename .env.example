# Server-only key restricted to Routes, Places API (New), Geocoding, and Weather.
GOOGLE_MAPS_API_KEY=
# Browser key restricted to Maps JavaScript API and this site's HTTP referrers.
GOOGLE_MAPS_BROWSER_KEY=
# Maximum number of distinct forecast coordinates in one trip plan.
GOOGLE_WEATHER_MAX_POINTS=120

# Production uses HTTPS and a gated backend. Generate the internal token with
# python3 -c 'import secrets; print(secrets.token_urlsafe(40))'
DJANGO_ENVIRONMENT=local
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=backend
SPOTTER_GATEWAY_TOKEN=

# Local defaults to public access. Production requires private access.
# Production rejects SPOTTER_GATEWAY_ACCESS=public.
SPOTTER_GATEWAY_ACCESS=
SPOTTER_GATEWAY_USERNAME=
SPOTTER_GATEWAY_PASSWORD=

# Only set this when a trusted HTTPS proxy sits immediately in front of Kong.
KONG_TRUSTED_IPS=
