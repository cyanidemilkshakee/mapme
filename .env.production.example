# Copy to .env.production and replace every placeholder before starting production.
# Point this domain's A/AAAA records to the host and allow inbound ports 80/443.
SPOTTER_DOMAIN=routes.example.com
DJANGO_ENVIRONMENT=production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=routes.example.com
SPOTTER_GATEWAY_TOKEN=
SPOTTER_GATEWAY_ACCESS=private
SPOTTER_GATEWAY_USERNAME=
SPOTTER_GATEWAY_PASSWORD=

# The bundled Caddy container uses a fixed address that Kong trusts by default.
# Choose a different subnet and address if this subnet overlaps your host or VPC.
SPOTTER_PROXY_SUBNET=10.253.255.0/24
SPOTTER_PROXY_IP=10.253.255.2
WEB_PORT=10001

# Restrict the server key to Routes, Places API (New), Geocoding, and Weather,
# and to the server's outbound IP where your hosting provider offers a stable IP.
GOOGLE_MAPS_API_KEY=
# Restrict the browser key to Maps JavaScript API and https://routes.example.com/*.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_WEATHER_MAX_POINTS=120
API_REQUEST_RATE=150/minute
API_PLAN_RATE=15/minute
